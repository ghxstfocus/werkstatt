{
  "stages": [
    {
      "id": "py_compile_changed",
      "command": [
        "python3",
        "-m",
        "py_compile",
        "{changed_py_files}"
      ],
      "phase": "post_build"
    },
    {
      "id": "ruff_changed",
      "command": [
        "ruff",
        "check",
        "{changed_py_files}"
      ],
      "phase": "post_build"
    },
    {
      "id": "state_drift",
      "command": [
        "python3",
        "tools/state_drift.py",
        "--check"
      ],
      "phase": "post_build",
      "timeout": 30,
      "hart": true
    },
    {
      "id": "mypy_changed",
      "command": [
        "python3",
        "-m",
        "mypy",
        "--follow-imports=silent",
        "--no-error-summary",
        "{changed_py_files}"
      ],
      "phase": "post_build",
      "timeout": 90
    },
    {
      "id": "pytest_changed",
      "command": [
        "python3",
        "-m",
        "pytest",
        "{changed_test_files}",
        "-q"
      ],
      "phase": "post_build"
    },
    {
      "id": "contract_check",
      "command": [
        "python3",
        "tools/state_inventory.py",
        "--changed",
        "{task_files}"
      ],
      "phase": "post_build",
      "timeout": 30
    },
    {
      "id": "pytest_regression",
      "command": [
        "python3",
        "-m",
        "pytest",
        "-q"
      ],
      "phase": "phase_end",
      "timeout": 600
    }
  ]
}
