{
  "stages": [
    {
      "id": "py_compile_changed",
      "command": [
        "python3",
        "-m",
        "py_compile",
        "{changed_py_files}"
      ],
      "phase": "post_build",
      "timeout": 60,
      "hart": true
    },
    {
      "id": "ruff_changed",
      "command": [
        "python3",
        "-m",
        "ruff",
        "check",
        "{changed_py_files}"
      ],
      "phase": "post_build",
      "timeout": 120,
      "hart": true
    },
    {
      "id": "state_drift",
      "command": [
        "python3",
        "tools/state_drift.py",
        "--check"
      ],
      "phase": "post_build",
      "timeout": 30,
      "hart": true
    },
    {
      "id": "control_drift",
      "command": [
        "python3",
        "tools/control_drift.py",
        "--check"
      ],
      "phase": "post_build",
      "timeout": 30,
      "hart": true
    },
    {
      "id": "import_drift",
      "command": [
        "python3",
        "tools/import_drift.py"
      ],
      "phase": "post_build",
      "timeout": 60,
      "hart": true
    },
    {
      "id": "mypy_changed",
      "command": [
        "python3",
        "-m",
        "mypy",
        "--follow-imports=silent",
        "--no-error-summary",
        "{changed_py_files}"
      ],
      "phase": "post_build",
      "timeout": 90,
      "hart": true
    },
    {
      "id": "pytest_changed",
      "command": [
        "python3",
        "-m",
        "pytest",
        "{changed_test_files}",
        "-q"
      ],
      "phase": "post_build",
      "timeout": 300,
      "hart": true
    },
    {
      "id": "contract_check",
      "command": [
        "python3",
        "tools/state_inventory.py",
        "--changed",
        "{task_files}"
      ],
      "phase": "post_build",
      "timeout": 30,
      "hart": true
    },
    {
      "id": "doku_drift",
      "command": [
        "python3",
        "tools/doku_check.py",
        "--strict",
        "--limit",
        "5",
        "--worktree"
      ],
      "phase": "phase_end",
      "timeout": 30,
      "hart": true
    },
    {
      "id": "pytest_regression",
      "command": [
        "python3",
        "-m",
        "pytest",
        "-q"
      ],
      "requires": "{changed_py_files}",
      "phase": "phase_end",
      "timeout": 300,
      "hart": true
    }
  ]
}
