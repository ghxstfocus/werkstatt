{
  "stages": [
    {
      "id": "py_compile_changed",
      "command": [
        "python3",
        "-m",
        "py_compile",
        "{changed_py_files}"
      ],
      "phase": "post_build",
      "timeout": 60
    },
    {
      "id": "ruff_changed",
      "command": [
        "python3",
        "-m",
        "ruff",
        "check",
        "{changed_py_files}"
      ],
      "phase": "post_build",
      "timeout": 120
    },
    {
      "id": "mypy_changed",
      "command": [
        "python3",
        "-m",
        "mypy",
        "--follow-imports=silent",
        "--no-error-summary",
        "{changed_py_files}"
      ],
      "phase": "post_build",
      "timeout": 90
    },
    {
      "id": "pytest_changed",
      "command": [
        "python3",
        "-m",
        "pytest",
        "{changed_test_files}",
        "-q"
      ],
      "phase": "post_build",
      "timeout": 300
    },
    {
      "id": "pytest_regression",
      "command": [
        "python3",
        "-m",
        "pytest",
        "-q"
      ],
      "requires": "{changed_non_test_py_files}",
      "phase": "phase_end",
      "timeout": 300
    }
  ]
}
